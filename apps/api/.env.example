# Copy to .env (and to .env.test for the test database), then fill in.
# If your PostgreSQL password has special characters (@ : / # ?), URL-encode them.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/fundtracker?schema=public"

# Where the web app runs (used in email links)
WEB_URL="http://localhost:5173"
API_PORT=4000

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-of-48-characters"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Set to true only when running behind a reverse proxy (nginx, Render, etc.)
TRUST_PROXY=false

# Email. Leave SMTP_HOST empty in development: emails are printed in the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fund Tracker <no-reply@example.com>"

# Local file storage (Phase 5+)
UPLOAD_DIR=./storage

# ── Production ──
# NODE_ENV=production turns on https-only cookies, HSTS and quieter mail logs.
# NODE_ENV=production
# Serve the built web app (apps/web/dist) from this same process, so one service is enough.
# SERVE_WEB=true
# WEB_DIST=../web/dist
# Cookies are https-only in production. Set false ONLY on a trusted network without https.
# COOKIE_SECURE=true
